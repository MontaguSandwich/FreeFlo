# === FreeFlo Attestation Service — env template ===
# Copy to deploy/attestation.env and fill the <...> values from your working LOCAL attestation env.
# Loaded by docker-compose (env_file). deploy/*.env is gitignored — never commit the filled file.

PORT=4001
RUST_LOG=info

# Witness signing key (FreeFlo-controlled). Its address must be an authorized witness on the verifier.
WITNESS_PRIVATE_KEY=<witness-private-key 0x...>

# Chain + audited contracts (Base mainnet).
CHAIN_ID=8453
RPC_URL=<base rpc, e.g. https://base-mainnet.g.alchemy.com/v2/KEY>
VERIFIER_CONTRACT=0x5602D796052ABDaD862FEf8011CA2cedB5132A9b
OFFRAMP_CONTRACT=0x57c621994616110a50bD820388e4E8a41F00b4D7

# TIER-1 sign-once arbiter — enables the Compact attestation branch (bind IBAN->mandate, sign
# intentHash=keccak(claimHash,filler)). Without it, Compact attestation requests are rejected.
COMPACT_ARBITER=0x4fbc96CA129F9f2f109994b1Cb77dF58dD963001

# REQUIRED — pinned TLSNotary notary public key(s), SEC1, comma-separated. The service refuses to
# start without this. Must correspond to the prover's NOTARY_PRIVATE_KEY (solver side).
NOTARY_PUBLIC_KEYS=<notary public key(s)>

# Inbound solver auth: comma-separated API keys accepted from the solver via X-Solver-API-Key.
# Must include the solver's ATTESTATION_API_KEY.
SOLVER_API_KEYS=<shared solver api key>

# Allowed TLS server hostnames that may appear in proofs (Qonto prod and/or sandbox).
ALLOWED_SERVERS=<copy from your local env, e.g. thirdparty.qonto.com,thirdparty-sandbox.staging.qonto.co>
