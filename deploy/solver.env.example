# === FreeFlo Solver — env template ===
# Easiest path: copy your working local `solver/.env.production` here, then KEEP the Docker-overrides
# block below as-is and add COMPACT_FILL_API_KEY. Loaded via ENV_FILE=/app/solver.env (dotenv
# override:true) and bind-mounted read-write so rotating Qonto tokens persist. deploy/*.env is gitignored.

# --- DOCKER OVERRIDES (must be exactly these inside the container) ---
ATTESTATION_ENABLED=true
ATTESTATION_SERVICE_URL=http://attestation-service:4001
PROVER_ENABLED=true
TLSN_EXAMPLES_PATH=/app/providers/prover/adapters/qonto
DB_PATH=/app/data/solver-production.db
PROOF_STORAGE_PATH=/app/data/proofs
HEALTH_PORT=8080
QUOTE_API_PORT=8081

# --- NEW (Phase 1) — must MATCH the frontend's COMPACT_FILL_API_KEY on Vercel ---
COMPACT_FILL_API_KEY=<generate, e.g.  openssl rand -hex 24>

# --- Chain + contracts (Base mainnet) ---
CHAIN_ID=8453
RPC_URL=<base rpc, e.g. https://base-mainnet.g.alchemy.com/v2/KEY>
OFFRAMP_V3_ADDRESS=0x57c621994616110a50bD820388e4E8a41F00b4D7
PAYMENT_VERIFIER_ADDRESS=0x5602D796052ABDaD862FEf8011CA2cedB5132A9b
FIAT_TO_FIAT_ROUTER_ADDRESS=0xF8010c7B323ABa20d37cAaD32D97C1967e4C1380
COMPACT_ARBITER_ADDRESS=0x4fbc96CA129F9f2f109994b1Cb77dF58dD963001
FREEFLO_ALLOCATOR_ADDRESS=0x2C870C28C9eE230689a778920875fb7c2AFC535b
MIN_USDC_AMOUNT=100000

# --- Keys / auth (copy from your local env) ---
SOLVER_PRIVATE_KEY=<solver/filler/allocator key 0x... — fund with a little Base ETH for fill gas>
NOTARY_PRIVATE_KEY=<notary key; its pubkey must be in attestation NOTARY_PUBLIC_KEYS>
ATTESTATION_API_KEY=<must be listed in attestation SOLVER_API_KEYS>

# --- Qonto (copy from your local env) ---
QONTO_ENABLED=true
QONTO_AUTH_METHOD=oauth
QONTO_CLIENT_ID=<...>
QONTO_CLIENT_SECRET=<...>
QONTO_ACCESS_TOKEN=<...>
QONTO_REFRESH_TOKEN=<...>
QONTO_BANK_ACCOUNT_ID=<...>
QONTO_BANK_ACCOUNT_SLUG=<...>
QONTO_USE_SANDBOX=<true|false>
QONTO_STAGING_TOKEN=<sandbox only>
QONTO_HOST=<e.g. thirdparty.qonto.com (prod) or thirdparty-sandbox.staging.qonto.co>
QONTO_FEE_BPS=50
