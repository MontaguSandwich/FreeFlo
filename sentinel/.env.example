# FreeFlo Sentinel — copy to .env (which is gitignored). Only secrets are required;
# everything else has a sensible default in src/config.ts.

# --- chain ---
RPC_URL=https://mainnet.base.org
FIAT_TO_FIAT_ROUTER=0xF8010c7B323ABa20d37cAaD32D97C1967e4C1380
OFFRAMP_V3=0x57c621994616110a50bD820388e4E8a41F00b4D7

# How far back to scan TransferInitiated for active router users, and the per-call
# chunk (public RPCs cap eth_getLogs ranges — keep chunks modest, or use an Alchemy URL).
SENTINEL_LOOKBACK_BLOCKS=40000
SENTINEL_CHUNK_BLOCKS=5000
# Optional comma-separated addresses to always check (belt-and-suspenders / testing).
SENTINEL_WATCH_USERS=

# --- solver health (internal on the EC2 box; 8080 is firewalled from outside) ---
SOLVER_HEALTH_URL=http://127.0.0.1:8080

# --- loop + self-heal ---
SENTINEL_INTERVAL_MS=120000
# Non-refund self-heal (restart solver / refresh token). Leave false until proven stable.
SENTINEL_AUTOHEAL=false
SENTINEL_COMPOSE_FILE=/home/ec2-user/freeflo/docker-compose.yml

# --- alerting (secrets — keep these only in .env, never commit) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- trade-tracker bot (intent activity feed; a SEPARATE bot) ---
TRACKER_BOT_TOKEN=
TRACKER_CHAT_ID=
# Start block for the feed. Empty = current block (forward-only, no history dump).
TRACKER_START_BLOCK=
TRACKER_INTERVAL_MS=30000
